// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DIRECTOR
  ADMINISTRATOR
  ENGINEER
  EMPLOYEE
}

model Employee {
  id                     String       @id @default(uuid())
  firstName              String
  lastName               String
  middleName             String?
  emergencyContactPerson String?
  emergencyContactNo     String?
  position               String
  hourlyRate             Decimal
  skills                 String[]
  createdAt              DateTime     @default(now())
  createdById            String?
  createdBy              UserAccount? @relation("EmployeeCreatedBy", fields: [createdById], references: [id])

  account                UserAccount?   @relation("EmployeeAccount")
  editLogs               StaffEditLog[] @relation("EmployeeEditLogs")
}

model UserAccount {
  id           String    @id @default(uuid())
  employeeId   String    @unique
  employee     Employee  @relation("EmployeeAccount", fields: [employeeId], references: [id])
  username     String    @unique
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  createdEmployees Employee[]     @relation("EmployeeCreatedBy")
  staffEdits       StaffEditLog[] @relation("StaffEditsMade")
}

// Audit trail for edits made to a staff member's Employee/UserAccount record
// (e.g. hourlyRate, position, isActive) — lets Directors see who changed what,
// since an Administrator could otherwise quietly edit someone's pay rate.
model StaffEditLog {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee    @relation("EmployeeEditLogs", fields: [employeeId], references: [id])
  editedById String
  editedBy   UserAccount @relation("StaffEditsMade", fields: [editedById], references: [id])
  field      String
  oldValue   String?
  newValue   String?
  createdAt  DateTime    @default(now())
}