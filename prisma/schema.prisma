// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DIRECTOR
  ADMINISTRATOR
  ENGINEER
  EMPLOYEE
}

enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  SEPARATED
  DIVORCED
}

enum EmploymentType {
  PROBATIONARY
  REGULAR
  CONTRACTUAL
}

model Employee {
  id                           String          @id @default(uuid())
  employeeNo                   String?         @unique
  firstName                    String
  lastName                     String
  middleName                   String?
  phoneNo                      String?
  email                        String?
  birthDate                    DateTime?
  civilStatus                  CivilStatus?
  address                      String?
  emergencyContactPerson       String?
  emergencyContactNo           String?
  emergencyContactRelationship String?
  position                     String
  employmentType               EmploymentType?
  dateHired                    DateTime?
  hourlyRate                   Decimal
  skills                       String[]
  tinNo                        String?
  sssNo                        String?
  philhealthNo                 String?
  pagibigNo                    String?
  createdAt                    DateTime        @default(now())
  createdById                  String?
  createdBy                    UserAccount?    @relation("EmployeeCreatedBy", fields: [createdById], references: [id])

  account             UserAccount?         @relation("EmployeeAccount")
  editLogs            StaffEditLog[]       @relation("EmployeeEditLogs")
  scheduleAssignments ScheduleAssignment[] @relation("EmployeeScheduleAssignments")
  reimbursements      Reimbursement[]      @relation("EmployeeReimbursements")
  fundReleases        FundRelease[]        @relation("EmployeeFundReleases")
  attendance          Attendance[]         @relation("EmployeeAttendance")
  overtimeRequests    OvertimeRequest[]    @relation("EmployeeOvertime")
  payrollAdjustments  PayrollAdjustment[]  @relation("EmployeePayrollAdjustments")
}

model UserAccount {
  id                  String    @id @default(uuid())
  employeeId          String    @unique
  employee            Employee  @relation("EmployeeAccount", fields: [employeeId], references: [id])
  username            String    @unique
  passwordHash        String
  role                Role
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  // Brute-force lockout. Stored on the row rather than in memory so it holds
  // across restarts and across instances behind a load balancer.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // Every session issued before this instant is refused. Set on password
  // change so a stolen or shared login dies the moment the password rotates,
  // instead of surviving until the 7-day token expires.
  sessionsRevokedAt   DateTime?

  createdEmployees     Employee[]          @relation("EmployeeCreatedBy")
  staffEdits           StaffEditLog[]      @relation("StaffEditsMade")
  createdSchedules     Schedule[]          @relation("ScheduleCreatedBy")
  scheduleEdits        ScheduleEditLog[]   @relation("ScheduleEditsMade")
  reimbursementReviews Reimbursement[]     @relation("ReimbursementReviewedBy")
  fundReleases         FundRelease[]       @relation("FundReleasedBy")
  notifications        Notification[]      @relation("NotificationRecipient")
  overtimeReviews      OvertimeRequest[]   @relation("OvertimeReviewedBy")
  payrollAdjustments   PayrollAdjustment[] @relation("PayrollAdjustmentsMade")
  payrollReleases      PayrollRelease[]    @relation("PayrollReleases")
  pushSubscriptions    PushSubscription[]  @relation("AccountPushSubscriptions")
  createdProjects      Project[]           @relation("ProjectCreatedBy")
  projectEdits         ProjectEditLog[]    @relation("ProjectEditsMade")
  companyExpenses      CompanyExpense[]    @relation("CompanyExpensesRecorded")
}

// One browser that has agreed to receive notifications.
//
// Per *device*, not per person: an administrator with the portal open on a
// desktop and installed on their phone is two rows, and both should buzz. The
// endpoint is the address the browser's push service gave us and is unique by
// construction — re-subscribing on the same device returns the same one, which
// is what makes this an upsert rather than a growing pile of duplicates.
//
// The two keys are the browser's half of the encryption: every payload is
// sealed to them so the push service in the middle — Google, Mozilla, Apple —
// carries ciphertext it cannot read.
model PushSubscription {
  id String @id @default(uuid())

  accountId String
  account   UserAccount @relation("AccountPushSubscriptions", fields: [accountId], references: [id], onDelete: Cascade)

  /**
   * Where the browser's push service wants deliveries posted.
   */
  endpoint String @unique
  /**
   * The device's public key, for sealing the payload.
   */
  p256dh   String
  /**
   * The device's auth secret, the other half of the same.
   */
  auth     String

  /**
   * Roughly which device this is, so somebody can recognise their own.
   */
  userAgent String?

  createdAt  DateTime @default(now())
  /**
   * Last time a delivery to this endpoint was accepted.
   */
  lastSeenAt DateTime @default(now())

  // "Everyone to tell about this" is the only question ever asked of it.
  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationType {
  SCHEDULE_ASSIGNED
  LIQUIDATION_SUBMITTED
  FUND_RELEASED
  OVERTIME_REQUESTED
  PAYSLIP_RELEASED
}

// Addressed to a UserAccount rather than an Employee: an inbox only means
// something for someone who can sign in and read it.
//
// The title and body are written once, at the moment the thing happened, and
// stored as plain text. That's deliberate — re-deriving the wording later from
// live rows would make an old notification change its story (or vanish) when
// the schedule it referred to is edited or deleted.
//
// There is no read flag: a notification is a nudge with a lifetime, not a
// record. Opening it or clearing the list deletes the row, so the table only
// ever holds what someone still has to look at. Nothing is lost by that — the
// schedule, liquidation or fund release it points at is the actual record,
// with its own timestamps and actor.
model Notification {
  id          String           @id @default(uuid())
  recipientId String
  recipient   UserAccount      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String
  // Where tapping it should land. Nullable so a notification with nowhere
  // useful to go is still valid.
  href        String?
  createdAt   DateTime         @default(now())

  // Serves both the inbox query (newest first for one person) and the count.
  @@index([recipientId, createdAt])
}

// Audit trail for edits made to a staff member's Employee/UserAccount record
// (e.g. hourlyRate, position, isActive) — lets Directors see who changed what,
// since an Administrator could otherwise quietly edit someone's pay rate.
model StaffEditLog {
  id         String      @id @default(uuid())
  employeeId String
  employee   Employee    @relation("EmployeeEditLogs", fields: [employeeId], references: [id])
  editedById String
  editedBy   UserAccount @relation("StaffEditsMade", fields: [editedById], references: [id])
  field      String
  oldValue   String?
  newValue   String?
  createdAt  DateTime    @default(now())

  // Always read as "this person's edits, newest first", on the staff record.
  @@index([employeeId, createdAt])
}

// How the client is registered with the BIR — drives how their invoices
// are computed, so it's recorded alongside the TIN.
enum TaxStatus {
  VAT
  NON_VAT
  VAT_EXEMPT
  ZERO_RATED
}

// Clients are companies/customers AeroCoole services. They never log in —
// no UserAccount, no role — this is purely business/contact record-keeping.
model Client {
  id           String     @id @default(uuid())
  name         String
  // The short form the office actually says out loud — "ACS" for AEON CREDIT
  // SERVICE (Philippines) INC. Null means nobody has set one, and the acronym
  // is derived from the registered name instead (see clientAcronym in
  // lib/documents.ts). Deliberately not unique: two clients can genuinely
  // abbreviate the same, and the serial in front of it is what makes a report
  // filename unique.
  acronym      String?
  // The code the office files this customer under — theirs, not ours, and the
  // one they quote on a purchase order. Unique because a code that identifies
  // two customers identifies neither; optional because plenty of clients never
  // get one, and Postgres lets a unique column hold as many nulls as it likes.
  customerCode String?    @unique
  tin          String?
  taxStatus    TaxStatus?
  address      String
  phoneNo      String?
  email        String?
  createdAt    DateTime   @default(now())

  branches           Branch[]
  contacts           ClientContact[]
  schedules          Schedule[]
  reimbursementItems ReimbursementItemClient[] @relation("ClientReimbursementItems")
  attendanceReports  AttendanceReport[]        @relation("ClientAttendanceReports")
  projects           Project[]                 @relation("ClientProjects")
  companyExpenses    CompanyExpense[]          @relation("ClientCompanyExpenses")
}

// A client can have any number of people you'd call — accounts payable,
// building admin, the on-site engineer. Separate from Schedule's per-job
// contact, which is whoever meets the crew for that specific visit.
model ClientContact {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  position  String?
  phoneNo   String?
  email     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String
  createdAt DateTime @default(now())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  schedules         Schedule[]
  attendanceReports AttendanceReport[] @relation("BranchAttendanceReports")
}

// BACKJOB replaced SURVEY and TROUBLESHOOT — a return visit to redo work
// already billed, which is the distinction the office actually tracks.
// Postgres can't drop an enum value, so the type was rebuilt and any rows
// carrying the retired two were moved onto BACKJOB by
// prisma/worktype-backjob.mts. Run that rather than `db push` if this enum
// ever needs values removed again.
enum WorkType {
  INSTALLATION
  REPAIR
  MAINTENANCE
  CLEANING
  INSPECTION
  BACKJOB
}

// PENDING is the only "upcoming" state — everything else is an outcome
// recorded after the job happens (or was supposed to happen).
enum ScheduleStatus {
  PENDING
  COMPLETED
  NEED_TO_RETURN
  RESCHEDULED
  CANCELLED
}

// One row per job/booking. Contact person/number are captured here (not on
// Branch) since a job's on-site contact can differ from branch to branch —
// and Branch itself doesn't store contact info.
//
// A job carries three separate facts about *what* and *where*, and they answer
// different questions:
//
//   client       who is being billed
//   branch       which of their sites the crew drives to — null means head
//                office, and this is the only thing that decides the address
//   salesOrderNo which job it delivers, and so which project's books the
//                labour lands on
//
// The sales order is a number rather than a relation to Project, matching
// CompanyExpense and ReimbursementItemClient: it is the key the COGS roll-up
// already groups by, it is unique, and a row can still name the job it was for
// if the project is ever deleted. Nullable only because schedules booked before
// sales orders reached this model have none — every new one is required to
// carry one.
model Schedule {
  id            String         @id @default(uuid())
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id])
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id])
  salesOrderNo  String?
  date          DateTime
  startTime     DateTime
  endTime       DateTime
  contactPerson String?
  contactNumber String?
  // Free-text notes for whoever runs the job — access instructions, unit
  // numbers, "bring the 3m ladder". Optional, and deliberately not structured:
  // it's the field that catches whatever the other columns don't.
  remarks       String?
  workTypes     WorkType[]
  status        ScheduleStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  createdById   String?
  createdBy     UserAccount?   @relation("ScheduleCreatedBy", fields: [createdById], references: [id])

  assignments ScheduleAssignment[]
  editLogs    ScheduleEditLog[]

  // The calendar reads a month at a time and the day view reads one day, so
  // every query here starts by narrowing on the date. Without this the grid is
  // a sequential scan that grows with every job ever booked.
  @@index([date])
  // "What has this client had done" — the service history on the client record.
  @@index([clientId, date])
  // The dashboard counts jobs still to run; status alone is low-cardinality, so
  // it is paired with the date that always accompanies it.
  @@index([status, date])
  // "Every visit booked against this sales order" — the same key the COGS
  // roll-up and the employees' liquidations already group by.
  @@index([salesOrderNo])
}

// Who changed what on a job after it was booked.
//
// The same shape as StaffEditLog, and for the same reason: a schedule is an
// instruction to send people somewhere, so "the time moved" and "they were
// stood down" are questions that get asked afterwards, sometimes weeks later
// by someone who wasn't there. One row per changed field, holding both sides
// of the change — a single row saying "edited" answers nothing.
//
// Deleting the job takes its history with it: the log is context for a
// schedule, not an independent audit trail, and an orphaned "start time
// changed" belonging to nothing is worse than no row at all.
model ScheduleEditLog {
  id         String      @id @default(uuid())
  scheduleId String
  schedule   Schedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  editedById String
  editedBy   UserAccount @relation("ScheduleEditsMade", fields: [editedById], references: [id])
  field      String
  oldValue   String?
  newValue   String?
  createdAt  DateTime    @default(now())

  // Always read as "this job's history, newest first", on the detail sheet.
  @@index([scheduleId, createdAt])
}

// Join table: which employees are assigned to a given schedule. Drives the
// scheduling calendar view (one calendar entry per assignment).
model ScheduleAssignment {
  id         String   @id @default(uuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation("EmployeeScheduleAssignments", fields: [employeeId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([scheduleId, employeeId])
  // The unique above indexes (scheduleId, employeeId) and so can serve a lookup
  // by schedule — but not one by employee, which is how an employee's own
  // schedule and every "is this person busy" check reads it.
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Reimbursements
//
// An employee spends their own money on a job, then liquidates: one claim
// holding one row per receipt. Admin reviews, then records the payout — which
// can be split across several transfers, hence a separate funding table.
// ---------------------------------------------------------------------------

enum ReimbursementStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model Reimbursement {
  id          String              @id @default(uuid())
  referenceNo String              @unique
  employeeId  String
  employee    Employee            @relation("EmployeeReimbursements", fields: [employeeId], references: [id])
  status      ReimbursementStatus @default(PENDING_REVIEW)
  totalAmount Decimal
  // One liquidation covers one day's spending, so the date and the compiled
  // receipt scan live here rather than on each line. The breakdown below says
  // where the money went; this says when, and holds the proof.
  expenseDate DateTime
  receiptKey  String?
  receiptName String?
  receiptType String?
  // Frozen at submission: whether the day being liquidated was already outside
  // the filing window. Recomputing later would flip as time passes.
  isLate      Boolean             @default(false)
  lateReason  String?
  note        String?
  submittedAt DateTime            @default(now())

  reviewedById String?
  reviewedBy   UserAccount? @relation("ReimbursementReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  items ReimbursementItem[]

  @@index([employeeId, status])
  // The employee's own history and the week window on it both order by filing
  // time; the admin queue reads every pending claim in that order too.
  @@index([employeeId, submittedAt])
  @@index([status, submittedAt])
}

// One receipt: what was bought, for which client, on which S.O., how much,
// and the scan itself. clientId is nullable because not every expense is
// billable to a client (fuel between sites, office supplies).
// One expense line: what was bought, for which client, on which S.O., how
// much. No date and no receipt of its own -- both belong to the claim, which
// covers a single day and carries one compiled scan.
model ReimbursementItem {
  id              String        @id @default(uuid())
  reimbursementId String
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  description     String
  amount          Decimal
  createdAt       DateTime      @default(now())

  // One payment can serve more than one job — a tank of fuel covering two
  // client sites is one expense, not two. `amount` stays the figure on the
  // receipt; the share charged to each job lives on the rows below. No rows
  // means the expense isn't tied to a client at all.
  clients ReimbursementItemClient[]
}

// Which job an expense was for. Separate row per client because both the S.O.
// number and the share of the money belong to the pairing, not to the expense:
// the same tank of fuel is S.O. 148 at one site and S.O. 151 at the other.
model ReimbursementItemClient {
  id       String            @id @default(uuid())
  itemId   String
  item     ReimbursementItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  clientId String
  client   Client            @relation("ClientReimbursementItems", fields: [clientId], references: [id])
  soNumber String?
  // The expense divided by the number of jobs it covered, to the centavo.
  // Stored rather than derived so a later edit to the line can't silently
  // restate what was already charged to a job. The shares always add back up
  // to the item's amount.
  amount   Decimal

  @@unique([itemId, clientId])
  @@index([clientId])
}

// The payout trail. Separate rows rather than fields on the claim so a partial
// release, a correction, or a second transfer all stay on the record.
// Money handed to an employee up front -- a working fund they draw on for job
// expenses and account for with liquidations. Tied to the person, not to a
// claim: the balance is what they still hold, across everything.
model FundRelease {
  id           String      @id @default(uuid())
  employeeId   String
  employee     Employee    @relation("EmployeeFundReleases", fields: [employeeId], references: [id])
  amount       Decimal
  method       String?
  reference    String?
  note         String?
  proofKey     String?
  proofName    String?
  proofType    String?
  releasedById String
  releasedBy   UserAccount @relation("FundReleasedBy", fields: [releasedById], references: [id])
  releasedAt   DateTime    @default(now())

  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Attendance
//
// One row per employee per working day. Timing in and out both capture a live
// selfie and a GPS fix, because the whole point of the record is that somebody
// was at a client's site at a particular hour -- a bare timestamp proves only
// that a phone was unlocked.
//
// The photograph and the coordinates are frozen evidence: they are written once
// with the punch and never edited afterwards. If a punch is wrong, the office
// corrects it on the record, and the original stays.
// ---------------------------------------------------------------------------

model Attendance {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation("EmployeeAttendance", fields: [employeeId], references: [id])
  // Local midnight of the day being worked, so one punch-in per person per day
  // regardless of what hour the shift starts.
  date       DateTime

  timeIn          DateTime
  // Nullable because the photograph is deleted once the punch is old enough to
  // be past dispute — see lib/purge-photos.ts. Null means "there is no photo",
  // and the type is what forces every reader to say so rather than presigning a
  // URL for an object that is no longer in the bucket.
  timeInSelfieKey String?
  timeInLatitude  Float
  timeInLongitude Float
  // Metres of uncertainty the device reported. Kept because a fix accurate to
  // 2km says something very different from one accurate to 8m.
  timeInAccuracy  Float?

  timeOut          DateTime?
  timeOutSelfieKey String?
  timeOutLatitude  Float?
  timeOutLongitude Float?
  timeOutAccuracy  Float?

  // Closed by the system rather than by the person, an hour after the shift
  // (plus any approved overtime) was due to end. The stamp is the scheduled
  // end, not the moment the sweep ran — see lib/auto-timeout.ts — so it must be
  // possible to tell the two apart: an auto-closed punch has no selfie and no
  // position behind it, and the office may want to ask what actually happened.
  autoTimedOut Boolean @default(false)

  // When the two punch photographs were deleted from storage. The punch itself
  // — times, positions, accuracy, reports — is kept forever; only the faces go.
  // Set even when there was nothing to delete, so a row is never re-examined.
  photosPurgedAt DateTime?

  // A free-text note about the day as a whole -- anything the office should
  // know that isn't a filed report.
  reportNote String?

  createdAt DateTime @default(now())

  overtime OvertimeRequest?
  // One per site visited. A crew can cover three branches in a day and file a
  // report for each, so this is a list rather than a column on the punch.
  reports  AttendanceReport[]

  @@unique([employeeId, date])
  @@index([employeeId, date])
  // The admin day view asks "everyone who punched on this date", with no
  // employee to lead on. A composite starting with employeeId can't serve that
  // — Postgres would scan the table — so the date needs an index of its own.
  @@index([date])
  // "Old enough to purge, and not purged yet" — the photo sweep's only
  // question. Without the second column it would walk every old row to find
  // none outstanding, every time it ran.
  @@index([date, photosPurgedAt])
}

// A one-off correction to somebody's pay for one cutoff.
//
// Payroll is computed from attendance, which is right for hours and wrong for
// everything the clock can't see: a transport allowance the office agreed to,
// a cash advance being paid back, a uniform deduction. Without somewhere to
// put those, they get done outside the system and the payslip stops matching
// what was handed over.
//
// The sign carries the meaning — positive adds to gross, negative deducts —
// so an adjustment is one row rather than two kinds of row. Kept against the
// cutoff it belongs to rather than a date, because that is the unit payroll is
// read and paid in; moving a person's attendance around can't detach it.
//
// Who made it is recorded and never edited: this is money someone decided to
// add or take away, and "who said so" is the first question asked about it.
model PayrollAdjustment {
  id          String      @id @default(uuid())
  employeeId  String
  employee    Employee    @relation("EmployeePayrollAdjustments", fields: [employeeId], references: [id], onDelete: Cascade)
  /**
   * Local midnight of the first day of the cutoff it applies to.
   */
  cutoffStart DateTime
  /**
   * What it is, in the office's words — "Transport allowance", "Cash advance".
   */
  label       String
  /**
   * Positive pays more, negative pays less. Never zero.
   */
  amount      Decimal
  /**
   * Retired. The form asked for a label ("What is it for?") and then a note,
   * which was the same question twice — so the note was removed from the UI
   * and from the action that writes it. Nothing reads or writes this column
   * any more; it is kept only so the text already typed into it isn't thrown
   * away. Drop it in a migration once that text has been looked at.
   */
  note        String?
  createdById String
  createdBy   UserAccount @relation("PayrollAdjustmentsMade", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())

  // Always read as "this person's adjustments for this cutoff".
  @@index([employeeId, cutoffStart])
  // And once per run, for everybody at once.
  @@index([cutoffStart])
}

// Payroll for a cutoff, published to the people it pays.
//
// One row per period, not per employee: releasing is a single decision about a
// finished run, and a per-employee table would let half a payroll be visible
// while the other half wasn't, which is a support call rather than a feature.
//
// Deliberately *not* a snapshot of the figures. Payroll is recomputed from
// attendance on every read — see app/admin/payroll/page.tsx — and that stays
// true after release, so a punch corrected on Monday reaches the payslip the
// employee is looking at instead of leaving two numbers in the building. The
// row records the decision and who made it; the arithmetic stays live.
model PayrollRelease {
  id String @id @default(uuid())

  /**
   * Local midnight of the cutoff's first day — the key adjustments use too.
   */
  cutoffStart DateTime @unique
  cutoffEnd   DateTime

  releasedById String
  releasedBy   UserAccount @relation("PayrollReleases", fields: [releasedById], references: [id])
  releasedAt   DateTime    @default(now())

  // "Which periods can this employee see" is the employee page's only query.
  @@index([cutoffStart])
}

// A coordinate pair turned into words, remembered so it is only ever asked
// once.
//
// Reverse geocoding is an outbound call to somebody else's service, and a punch
// carries two positions. Crews return to the same sites week after week, so the
// key is the coordinate rounded to four decimals — about 11 metres, which is
// finer than the GPS fixes being looked up and coarse enough that the whole
// company converges on a handful of rows. Without this, opening the same day
// twice would ask twice.
//
// `label` null means the lookup ran and the provider had nothing for that spot
// — cached deliberately, so a blank patch of map isn't re-asked on every view.
// A failed request caches nothing and is simply retried next time.
model GeocodedPlace {
  id        String   @id @default(uuid())
  // "14.2385,121.1648" — rounded, and a string rather than two floats because
  // this is an equality lookup and float keys don't compare reliably.
  key       String   @unique
  label     String?
  createdAt DateTime @default(now())
}

// What kind of paperwork a visit produced. PMS is the scheduled preventive
// maintenance round; SERVICE is a call-out -- a repair, a complaint, an
// installation. The two are filed on different forms and are chased separately
// by the office, so the distinction is stored rather than left to the filename.
enum AttendanceReportType {
  PMS
  SERVICE
}

// One report filed against one site visited during a shift.
//
// Attached to the punch that closes the day rather than to a schedule: a crew
// can be sent to three branches and come back with three reports, and the
// office needs all of them together with the day they were worked.
model AttendanceReport {
  id           String     @id @default(uuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  type AttendanceReportType

  clientId String
  client   Client  @relation("ClientAttendanceReports", fields: [clientId], references: [id])
  // Null when the client has no branches at all, which is most of them.
  branchId String?
  branch   Branch? @relation("BranchAttendanceReports", fields: [branchId], references: [id])

  // The number printed on the form the technician filled in on site. This is
  // what the office quotes back to a client, so it is stored as typed.
  serialNo String

  fileKey  String
  fileName String

  createdAt DateTime @default(now())

  @@index([attendanceId])
  @@index([clientId])
  @@index([serialNo])
  // The Documents tree narrows by type first, then groups by client and branch
  // inside it — every level of the folder browser starts from this pair.
  @@index([type, clientId])
  @@index([branchId])
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

// Asking to keep working past the shift that was scheduled. Tied to the day's
// attendance row, so a request can't exist without the punch it extends.
model OvertimeRequest {
  id           String     @id @default(uuid())
  attendanceId String     @unique
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation("EmployeeOvertime", fields: [employeeId], references: [id])

  // What the employee asked for. Never rewritten -- the office can grant
  // fewer hours than were requested, and "what was asked" has to survive that
  // for the request to still be auditable afterwards.
  hours  Decimal
  reason String

  // What was actually granted, when it differs from what was asked. Null means
  // the request stood as filed, which is the common case; payroll reads
  // `approvedHours ?? hours`.
  approvedHours Decimal?

  // Frozen at request time. The schedule it was measured against can be edited
  // later, and "was this filed inside the window?" has to stay answerable.
  shiftEndsAt DateTime
  requestedAt DateTime @default(now())

  status       OvertimeStatus @default(PENDING)
  reviewedById String?
  reviewedBy   UserAccount?   @relation("OvertimeReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  @@index([employeeId, status])
}

// ---------------------------------------------------------------------------
// Projects
//
// The company's own order book: one row per job sold, tracked from the day it
// starts to the day it is closed and paid. This is the ledger the office used
// to keep on a spreadsheet, so it is deliberately shaped like one — a running
// sales order number, the money as typed, and every derived figure left out.
//
// The VAT columns, gross profit and the monthly and yearly totals are NOT
// stored. They are arithmetic on the four figures below, and a stored copy is
// a second answer waiting to disagree with the first the moment somebody edits
// an amount. See lib/projects, which is the one place that arithmetic lives.
// ---------------------------------------------------------------------------

enum ProjectStatus {
  IN_PROGRESS
  ACCOUNT_RECEIVABLE
  BILLED
  FOR_BILLING
  ON_HOLD
  CLOSED
}

// The terms as the office writes them on a quotation. An enum rather than free
// text so the same terms can be counted and filtered later.
enum PaymentTerms {
  TWO_WEEKS
  UPON_COMPLETION
  NET_30
  NET_60
  DP30_PB60_RETENTION10
  DP50_COMPLETION50
}

model Project {
  id String @id @default(uuid())

  /**
   * "260001" — two digits of the year it was booked, then a running number.
   * Issued by the system and never edited; unique is what makes the numbering
   * safe when two people add a project at the same moment.
   */
  salesOrderNo String        @unique
  status       ProjectStatus @default(IN_PROGRESS)

  /**
   * Local midnight. The month a project belongs to is this date's month —
   * change it and the project moves, which is why nothing about its position
   * in the list is stored.
   */
  startDate DateTime
  endDate   DateTime?

  /**
   * Sales invoice number, once one has been issued.
   */
  siNo String?

  name     String
  clientId String
  client   Client       @relation("ClientProjects", fields: [clientId], references: [id])
  terms    PaymentTerms

  // The three figures anybody types. Decimal, not Float: these are pesos, and
  // binary floating point cannot hold 0.1 exactly — a column of them drifts.
  //
  // COGS is deliberately NOT among them. What a job cost is the sum of the
  // expenses liquidated against its sales order number — see lib/projects and
  // the roll-up in the tracker page. Storing it too would leave a second
  // answer that disagrees with the receipts the moment a claim is approved.
  projectAmount  Decimal
  cashCollection Decimal
  accrualRevenue Decimal

  createdById String
  createdBy   UserAccount @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  editLogs ProjectEditLog[]

  // The list is always "one year, grouped by month", and often "one client".
  @@index([startDate])
  @@index([clientId])
}

// Who changed what about a project, since it was booked.
//
// Same shape as ScheduleEditLog and for the same reason: a project carries
// money, and "who moved the COGS" is a question that gets asked weeks later.
// Values are resolved to the words the office uses — the client by name, the
// status and terms by label, the money already formatted — so a row read a year
// from now makes sense without joining anything back.
model ProjectEditLog {
  id         String      @id @default(uuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  editedById String
  editedBy   UserAccount @relation("ProjectEditsMade", fields: [editedById], references: [id])
  field      String
  oldValue   String?
  newValue   String?
  createdAt  DateTime    @default(now())

  // Always read as "this project's history, newest first".
  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------------------
// Expenses the office records itself
//
// The two cost figures on the project tracker are otherwise derived from other
// people's work: COGS from the expenses employees liquidate against a sales
// order, OPEX from what payroll would pay the admin side. Neither can hold a
// supplier invoice the office paid directly, a permit fee, or the electricity
// bill — money the company plainly spent with no punch and no receipt from a
// crew behind it.
//
// So this is the third source, and the only one anybody types. A row is either
// overhead or the cost of one job, and which it is decides whether it needs a
// sales order number: `COGS` rows carry one and land on that project, `OPEX`
// rows carry none and land on their month.
// ---------------------------------------------------------------------------

enum CompanyExpenseKind {
  OPEX
  COGS
}

model CompanyExpense {
  id          String             @id @default(uuid())
  kind        CompanyExpenseKind
  /**
   * Local midnight of the day the money was spent. For an OPEX row this is
   * what puts it in a month; for a COGS row the project decides the month, and
   * this is simply when it happened.
   */
  spentOn     DateTime
  description String
  amount      Decimal

  /**
   * Both null on an OPEX row, both set on a COGS row.
   * The sales order number rather than a relation to Project: it is what the
   * COGS roll-up groups by, the same key the employees' liquidations use, and
   * it is unique. The client is kept beside it so a row can still say who the
   * job was for if the project is ever deleted.
   */
  clientId     String?
  client       Client? @relation("ClientCompanyExpenses", fields: [clientId], references: [id])
  salesOrderNo String?

  createdById String
  createdBy   UserAccount @relation("CompanyExpensesRecorded", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())

  // "This month's overhead" and "this job's cost" are the only two questions.
  @@index([kind, spentOn])
  @@index([salesOrderNo])
}
