# ---------------------------------------------------------------------------
# AeroCoole — environment
# ---------------------------------------------------------------------------
#
# Copy to `.env` and fill in. This file is the committed template and holds no
# secrets; `.env` itself is git-ignored and must never be committed.
#
# Every value here is required in production unless marked optional.

# --- Timezone --------------------------------------------------------------
# REQUIRED IN PRODUCTION, and the one most likely to be forgotten.
#
# Attendance, payroll cutoffs, holidays and the photo-retention sweep are all
# computed from the *server's* local calendar day. Most hosts run in UTC, which
# is eight hours behind Manila — a punch at 00:30 files itself under the
# previous day, a cutoff starts at 4pm on the wrong date, and payroll follows.
#
# Set this and confirm after deploying that a late-evening punch lands on the
# right day.
TZ=Asia/Manila

# --- Database --------------------------------------------------------------
# DATABASE_URL is the pooled connection the app uses at runtime.
# DIRECT_URL is the non-pooled one the Prisma CLI needs — Supabase's pgbouncer
# doesn't support the advisory locks migrations rely on, and the CLI hangs
# without it.
DATABASE_URL=postgresql://user:password@host:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# --- Sessions --------------------------------------------------------------
# Signs the login cookie. Use a long random string, and a different one from
# any other environment: changing it signs everybody out, which is also how you
# revoke every session at once.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Cloudflare R2 (punch selfies, receipts, filed reports) -----------------
# An R2 API token scoped to the bucket with Object Read & Write. Keep the
# bucket PRIVATE — everything is served through short-lived signed URLs.
# Uploads go browser -> R2 directly, so the bucket needs this CORS rule:
#   AllowedOrigins: ["https://your-domain"]
#   AllowedMethods: ["PUT"]
#   AllowedHeaders: ["content-type"]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Web push notifications -------------------------------------------------
# Generate a fresh pair for production — do not reuse the development one:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Changing either key invalidates every subscription, and everybody has to turn
# notifications on again.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Where a push service should complain if deliveries go wrong. mailto: or https:
VAPID_SUBJECT=mailto:admin@aerocoole.ph

# --- Scheduled housekeeping (optional) --------------------------------------
# Closes abandoned punches and deletes punch photos past their retention.
# Both also run when the office opens the attendance page, so a cron is a
# tidiness improvement rather than a requirement. Point one at
#   GET /api/attendance/auto-timeout
# hourly, sending `Authorization: Bearer <this value>`. With no secret set the
# route stays shut.
CRON_SECRET=

# --- Reverse geocoding (optional) -------------------------------------------
# Turns punch coordinates into place names via Nominatim, whose usage policy
# asks for a contact address. Without it the map link still works; only the
# written address is missing.
NOMINATIM_CONTACT=
